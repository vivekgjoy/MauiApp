<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Views.Maui.Controls;assembly=SkiaSharp.Views.Maui.Controls"
             xmlns:toolpanels="clr-namespace:MauiApp.ImageEditor.Views.ToolPanels"
             xmlns:converters="clr-namespace:MauiApp.ImageEditor.Converters"
             xmlns:components="clr-namespace:MauiApp.Views.Components"
             x:Class="MauiApp.ImageEditor.SkiaSharpImageEditorPage"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             Padding="0"
             NavigationPage.HasNavigationBar="False"
             NavigationPage.HasBackButton="False">

    <ContentPage.Resources>
        <converters:ToolToBoolConverter x:Key="ToolToBool" />
        <converters:SubToolToBoolConverter x:Key="SubToolToBool" />
        <converters:CropModeToColorConverter x:Key="CropModeToColor" />
        <converters:ShapeTypeToColorConverter x:Key="ShapeTypeToColor" />
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <converters:SelectedToOpacityConverter x:Key="SelectedToOpacityConverter" />
        <converters:BoolToOpacityConverter x:Key="BoolToOpacityConverter" />
        <converters:BoolToColorConverter x:Key="BoolToColorConverter" />
        <converters:SelectedColorConverter x:Key="SelectedColorConverter" />
        <converters:IsSelectedColorConverter x:Key="IsSelectedColorConverter" />
    </ContentPage.Resources>

    <!-- Background Gradient (Same as other pages) -->
    <Grid>
        <BoxView>
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="{StaticResource TopCoral}" Offset="0.0" />
                    <GradientStop Color="{StaticResource BottomCoral}" Offset="1.0" />
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>

        <Grid RowDefinitions="Auto,Auto,*,Auto">

            <!-- Custom Header with Back Button and Title -->
            <components:GenericNavigationBar Grid.Row="0"
                                            Title="Edit Image"
                                            x:Name="NavigationBar" />

            <!-- Action Toolbar (Undo, Redo, Reset, Save) - Always Visible -->
            <Grid Grid.Row="1"
                  BackgroundColor="#1E1E1E"
                  HeightRequest="40"
                  Padding="20,0"
                  VerticalOptions="Center">

                <!-- LEFT SIDE - Hide when in editing mode -->
                <HorizontalStackLayout HorizontalOptions="Start"
                                       VerticalOptions="Center"
                                       Spacing="16"
                                       IsVisible="{Binding IsMainToolbarVisible}">

                    <!-- Folder -->
                    <Image Source="ic_open_folder_edit.svg"
                           WidthRequest="26" HeightRequest="26">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnOpenFolderClicked"/>
                        </Image.GestureRecognizers>
                    </Image>

                    <!-- Divider -->
                    <BoxView Color="#FFFFFF" Opacity="0.3"
                             WidthRequest="1"
                             HeightRequest="24"
                             VerticalOptions="Center"/>

                    <!-- Undo -->
                    <Image Source="ic_undo_edit.svg"
                           WidthRequest="26" HeightRequest="26"
                           Opacity="{Binding CanUndo, Converter={StaticResource BoolToOpacityConverter}}">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding UndoCommand}"/>
                        </Image.GestureRecognizers>
                    </Image>

                    <!-- Redo -->
                    <Image Source="ic_redo_edit.svg"
                           WidthRequest="26" HeightRequest="26"
                           Opacity="{Binding CanRedo, Converter={StaticResource BoolToOpacityConverter}}">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding RedoCommand}"/>
                        </Image.GestureRecognizers>
                    </Image>
                </HorizontalStackLayout>

                <!-- RIGHT SIDE - Hide when in editing mode -->
                <HorizontalStackLayout HorizontalOptions="End"
                                       VerticalOptions="Center"
                                       Spacing="16"
                                       IsVisible="{Binding IsMainToolbarVisible}">

                    <!-- Reset -->
                    <Image Source="ic_reset_image_edit.svg"
                           WidthRequest="26" HeightRequest="26"
                           Opacity="{Binding CanReset, Converter={StaticResource BoolToOpacityConverter}}">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ResetImageCommand}"/>
                        </Image.GestureRecognizers>
                    </Image>

                    <!-- Divider -->
                    <BoxView Color="#FFFFFF" Opacity="0.3"
                             WidthRequest="1"
                             HeightRequest="24"
                             VerticalOptions="Center"/>

                    <!-- Save -->
                    <Image Source="ic_save_image_edit.svg"
                           WidthRequest="26" HeightRequest="26">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SaveImageCommand}"/>
                        </Image.GestureRecognizers>
                    </Image>
                </HorizontalStackLayout>

                <!-- Check icon for Crop -->
                <Image Source="ic_check.svg"
                       HorizontalOptions="End"
                       VerticalOptions="Center"
                       Margin="16,0"
                       WidthRequest="26" HeightRequest="26"
                       IsVisible="{Binding CropVM.IsCropMode}">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding CropVM.ApplyCropCommand}"/>
                    </Image.GestureRecognizers>
                </Image>

                <!-- Check icon for Draw -->
                <Image Source="ic_check"
                       HorizontalOptions="End"
                       VerticalOptions="Center"
                       Margin="16,0"
                       WidthRequest="26" HeightRequest="26"
                       IsVisible="{Binding DrawVM.IsDrawMode}">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnDrawDoneTapped"/>
                    </Image.GestureRecognizers>
                </Image>

                <!-- Check icon for Shapes -->
                <Image Source="ic_check"
                       HorizontalOptions="End"
                       VerticalOptions="Center"
                       Margin="16,0"
                       WidthRequest="26" HeightRequest="26"
                       IsVisible="{Binding ShapesVM.IsShapeMode}">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnShapeDoneTapped"/>
                    </Image.GestureRecognizers>
                </Image>

                <!-- Check icon for Text -->
                <Image Source="ic_check"
                       HorizontalOptions="End"
                       VerticalOptions="Center"
                       Margin="16,0"
                       WidthRequest="26" HeightRequest="26"
                       IsVisible="{Binding TextVM.IsTextMode}">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTextDoneTapped"/>
                    </Image.GestureRecognizers>
                </Image>

            </Grid>

        <!-- CANVAS -->
        <Grid Grid.Row="2" x:Name="CanvasContainer" BackgroundColor="#121212">
            <!-- Transparent overlay to capture touch events (for Draw mode) -->
            <Grid BackgroundColor="Transparent"
                  InputTransparent="False"
                  x:Name="TouchOverlay">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnTouchOverlayTapped"/>
                    <PanGestureRecognizer PanUpdated="OnPanGestureUpdated"/>
                </Grid.GestureRecognizers>
            </Grid>
            <!-- CanvasView MUST be last so it's on top and receives touches for Shapes mode -->
            <skia:SKCanvasView x:Name="CanvasView"
                               PaintSurface="OnPaintSurface"
                               BackgroundColor="#121212"
                               IsEnabled="True"
                               EnableTouchEvents="True"
                               InputTransparent="False"/>
        </Grid>

            <!-- SLIDING PANEL FOR OTHER TOOLS -->
            <Grid Grid.Row="2" Grid.RowSpan="2" VerticalOptions="End"
                  IsVisible="{Binding IsToolPanelVisible}"
                  TranslationY="{Binding PanelTranslationY, FallbackValue=420}">
            <Grid BackgroundColor="Transparent"
                  HeightRequest="420"
                  VerticalOptions="End">
                
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Main Tool Panels -->
                <Grid Grid.Row="0" Padding="0"
                      IsVisible="{Binding SelectedSubToolType, Converter={StaticResource SubToolToBool}, ConverterParameter=None}">
                    <toolpanels:DrawToolPanel x:Name="DrawPanel"
                                             IsVisible="{Binding SelectedToolType, Converter={StaticResource ToolToBool}, ConverterParameter=Draw}" 
                                             BindingContext="{Binding DrawVM}"/>
                    <toolpanels:TextToolPanel x:Name="TextPanel"
                                             IsVisible="{Binding SelectedToolType, Converter={StaticResource ToolToBool}, ConverterParameter=Text}" 
                                             BindingContext="{Binding TextVM}"/>
                    <toolpanels:ShapesToolPanel x:Name="ShapesPanel"
                                               IsVisible="{Binding SelectedToolType, Converter={StaticResource ToolToBool}, ConverterParameter=Shapes}" 
                                               BindingContext="{Binding ShapesVM}"/>
                </Grid>

                <!-- Shapes Sub-Panel (Presets) -->
                <Grid Grid.Row="1" Padding="16,0" 
                      IsVisible="{Binding SelectedSubToolType, Converter={StaticResource SubToolToBool}, ConverterParameter=ShapesPresets}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" ColumnDefinitions="*,*,*,*,*" ColumnSpacing="16" RowSpacing="16">
                        <Image Source="ic_shape_custom" Grid.Column="0" WidthRequest="48" HeightRequest="48" BackgroundColor="Transparent">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnShapePresetTapped" CommandParameter="Custom"/>
                            </Image.GestureRecognizers>
                        </Image>
                        <Image Source="ic_shape_original" Grid.Column="1" WidthRequest="48" HeightRequest="48" BackgroundColor="Transparent">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnShapePresetTapped" CommandParameter="Original"/>
                            </Image.GestureRecognizers>
                        </Image>
                        <Image Source="ic_shape_circle.svg" Grid.Column="2" WidthRequest="48" HeightRequest="48" BackgroundColor="Transparent">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnShapePresetTapped" CommandParameter="Circle"/>
                            </Image.GestureRecognizers>
                        </Image>
                        <Image Source="ic_shape_ellipse" Grid.Column="3" WidthRequest="48" HeightRequest="48" BackgroundColor="Transparent">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnShapePresetTapped" CommandParameter="Ellipse"/>
                            </Image.GestureRecognizers>
                        </Image>
                        <Image Source="ic_shape_square" Grid.Column="4" WidthRequest="48" HeightRequest="48" BackgroundColor="Transparent">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnShapePresetTapped" CommandParameter="Square"/>
                            </Image.GestureRecognizers>
                        </Image>
                    </Grid>
                    <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*,*" ColumnSpacing="16" RowSpacing="16">
                        <Label Grid.Column="0" Text="Custom" TextColor="White" FontSize="10" HorizontalTextAlignment="Center"/>
                        <Label Grid.Column="1" Text="Original" TextColor="White" FontSize="10" HorizontalTextAlignment="Center"/>
                        <Label Grid.Column="2" Text="Circle" TextColor="White" FontSize="10" HorizontalTextAlignment="Center"/>
                        <Label Grid.Column="3" Text="Ellipse" TextColor="White" FontSize="10" HorizontalTextAlignment="Center"/>
                        <Label Grid.Column="4" Text="Square" TextColor="White" FontSize="10" HorizontalTextAlignment="Center"/>
                    </Grid>
                </Grid>
            </Grid>
            </Grid>

            <!-- BOTTOM AREA â€" FINAL SYNC FUSION 2025 CROP PANEL -->
            <Grid Grid.Row="3" HeightRequest="140" VerticalOptions="End" BackgroundColor="#1E1E1E">

                <!-- MAIN TOOLBAR (when not cropping or shaping) -->
                <Grid BackgroundColor="#1E1E1E"
                      Padding="0,10,0,20"
                      IsVisible="{Binding IsMainToolbarVisible}">

                <HorizontalStackLayout HorizontalOptions="CenterAndExpand"
                                       VerticalOptions="Center"
                                       Spacing="40">

                    <VerticalStackLayout Spacing="6" x:Name="CropToolContainer">
                        <Image x:Name="CropToolImage" Source="ic_crop_edit.svg" WidthRequest="28" HeightRequest="28">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnToolTapped" CommandParameter="Crop"/>
                            </Image.GestureRecognizers>
                        </Image>
                        <Label Text="Crop" TextColor="White" FontSize="11" HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Image Source="ic_shapes_edit.svg" WidthRequest="28" HeightRequest="28">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnToolTapped" CommandParameter="Shapes"/>
                            </Image.GestureRecognizers>
                        </Image>
                        <Label Text="Shapes" TextColor="White" FontSize="11" HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Image Source="ic_brush_edit.svg" WidthRequest="28" HeightRequest="28">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnToolTapped" CommandParameter="Draw"/>
                            </Image.GestureRecognizers>
                        </Image>
                        <Label Text="Draw" TextColor="White" FontSize="11" HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Image Source="ic_text_fields_edit.svg" WidthRequest="28" HeightRequest="28">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnToolTapped" CommandParameter="Text"/>
                            </Image.GestureRecognizers>
                        </Image>
                        <Label Text="Text" TextColor="White" FontSize="11" HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>

                </HorizontalStackLayout>
                </Grid>

                <!-- CROP PANEL -->
                <Grid BackgroundColor="#1E1E1E"
                      IsVisible="{Binding CropVM.IsCropMode}"
                      HeightRequest="140">

                <Grid.RowDefinitions>
                    <RowDefinition Height="70"/>
                    <RowDefinition Height="1"/>
                    <RowDefinition Height="69"/>
                </Grid.RowDefinitions>

                <!-- Crop Modes â€“ Scrollable horizontal list for all crop options -->
                <ScrollView Grid.Row="0"
                            Orientation="Horizontal"
                            HorizontalScrollBarVisibility="Never"
                            VerticalOptions="Center">
                    <HorizontalStackLayout Spacing="20"
                                          Padding="20,0"
                                          VerticalOptions="Center">

                        <!-- Custom -->
                        <VerticalStackLayout Spacing="0">
                            <Frame WidthRequest="44" HeightRequest="44"
                                   CornerRadius="12"
                                   Padding="0"
                                   Margin="0"
                                   HasShadow="False"
                                   BorderColor="Transparent"
                                   BackgroundColor="{Binding CropVM.SelectedCropMode, Converter={StaticResource CropModeToColor}, ConverterParameter=Custom}">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding CropVM.SelectCropModeCommand}" 
                                                          CommandParameter="Custom"/>
                                </Frame.GestureRecognizers>
                                <Image Source="ic_crop_custom.svg"
                                       WidthRequest="26" HeightRequest="26"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       Opacity="{Binding CropVM.SelectedCropMode, Converter={StaticResource SelectedToOpacityConverter}, ConverterParameter=Custom}"/>
                            </Frame>
                            <Label Text="Custom" FontSize="11" TextColor="White" 
                                   HorizontalTextAlignment="Center" Margin="0"/>
                        </VerticalStackLayout>

                        <!-- Original -->
                        <VerticalStackLayout Spacing="0">
                            <Frame WidthRequest="44" HeightRequest="44"
                                   CornerRadius="12"
                                   Padding="0"
                                   Margin="0"
                                   HasShadow="False"
                                   BorderColor="Transparent"
                                   BackgroundColor="{Binding CropVM.SelectedCropMode, Converter={StaticResource CropModeToColor}, ConverterParameter=Original}">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding CropVM.SelectCropModeCommand}" 
                                                          CommandParameter="Original"/>
                                </Frame.GestureRecognizers>
                                <Image Source="ic_original_edit.svg"
                                       WidthRequest="26" HeightRequest="26"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       Opacity="{Binding CropVM.SelectedCropMode, Converter={StaticResource SelectedToOpacityConverter}, ConverterParameter=Original}"/>
                            </Frame>
                            <Label Text="Original" FontSize="11" TextColor="White" 
                                   HorizontalTextAlignment="Center" Margin="0"/>
                        </VerticalStackLayout>

                        <!-- Circle -->
                        <VerticalStackLayout Spacing="0">
                            <Frame WidthRequest="44" HeightRequest="44"
                                   CornerRadius="12"
                                   Padding="0"
                                   Margin="0"
                                   HasShadow="False"
                                   BorderColor="Transparent"
                                   BackgroundColor="{Binding CropVM.SelectedCropMode, Converter={StaticResource CropModeToColor}, ConverterParameter=Circle}">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding CropVM.SelectCropModeCommand}" 
                                                          CommandParameter="Circle"/>
                                </Frame.GestureRecognizers>
                                <Image Source="ic_crop_circle.svg"
                                       WidthRequest="26" HeightRequest="26"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       Opacity="{Binding CropVM.SelectedCropMode, Converter={StaticResource SelectedToOpacityConverter}, ConverterParameter=Circle}"/>
                            </Frame>
                            <Label Text="Circle" FontSize="11" TextColor="White" 
                                   HorizontalTextAlignment="Center" Margin="0"/>
                        </VerticalStackLayout>

                        <!-- Square -->
                        <VerticalStackLayout Spacing="0">
                            <Frame WidthRequest="44" HeightRequest="44"
                                   CornerRadius="12"
                                   Padding="0"
                                   Margin="0"
                                   HasShadow="False"
                                   BorderColor="Transparent"
                                   BackgroundColor="{Binding CropVM.SelectedCropMode, Converter={StaticResource CropModeToColor}, ConverterParameter=Square}">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding CropVM.SelectCropModeCommand}" 
                                                          CommandParameter="Square"/>
                                </Frame.GestureRecognizers>
                                <Image Source="ic_crop_square.svg"
                                       WidthRequest="26" HeightRequest="26"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       Opacity="{Binding CropVM.SelectedCropMode, Converter={StaticResource SelectedToOpacityConverter}, ConverterParameter=Square}"/>
                            </Frame>
                            <Label Text="Square" FontSize="11" TextColor="White" 
                                   HorizontalTextAlignment="Center" Margin="0"/>
                        </VerticalStackLayout>

                        <!-- 3:1 -->
                        <VerticalStackLayout Spacing="0">
                            <Frame WidthRequest="44" HeightRequest="44"
                                   CornerRadius="12"
                                   Padding="0"
                                   Margin="0"
                                   HasShadow="False"
                                   BorderColor="Transparent"
                                   BackgroundColor="{Binding CropVM.SelectedCropMode, Converter={StaticResource CropModeToColor}, ConverterParameter=Ratio3_1}">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding CropVM.SelectCropModeCommand}" 
                                                          CommandParameter="Ratio3_1"/>
                                </Frame.GestureRecognizers>
                                <Image Source="ic_crop_3_1.svg"
                                       WidthRequest="26" HeightRequest="26"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       Opacity="{Binding CropVM.SelectedCropMode, Converter={StaticResource SelectedToOpacityConverter}, ConverterParameter=Ratio3_1}"/>
                            </Frame>
                            <Label Text="3:1" FontSize="11" TextColor="White" 
                                   HorizontalTextAlignment="Center" Margin="0"/>
                        </VerticalStackLayout>

                        <!-- 3:2 -->
                        <VerticalStackLayout Spacing="0">
                            <Frame WidthRequest="44" HeightRequest="44"
                                   CornerRadius="12"
                                   Padding="0"
                                   Margin="0"
                                   HasShadow="False"
                                   BorderColor="Transparent"
                                   BackgroundColor="{Binding CropVM.SelectedCropMode, Converter={StaticResource CropModeToColor}, ConverterParameter=Ratio3_2}">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding CropVM.SelectCropModeCommand}" 
                                                          CommandParameter="Ratio3_2"/>
                                </Frame.GestureRecognizers>
                                <Image Source="ic_crop_3_2.svg"
                                       WidthRequest="26" HeightRequest="26"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       Opacity="{Binding CropVM.SelectedCropMode, Converter={StaticResource SelectedToOpacityConverter}, ConverterParameter=Ratio3_2}"/>
                            </Frame>
                            <Label Text="3:2" FontSize="11" TextColor="White" 
                                   HorizontalTextAlignment="Center" Margin="0"/>
                        </VerticalStackLayout>

                        <!-- 4:3 -->
                        <VerticalStackLayout Spacing="0">
                            <Frame WidthRequest="44" HeightRequest="44"
                                   CornerRadius="12"
                                   Padding="0"
                                   Margin="0"
                                   HasShadow="False"
                                   BorderColor="Transparent"
                                   BackgroundColor="{Binding CropVM.SelectedCropMode, Converter={StaticResource CropModeToColor}, ConverterParameter=Ratio4_3}">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding CropVM.SelectCropModeCommand}" 
                                                          CommandParameter="Ratio4_3"/>
                                </Frame.GestureRecognizers>
                                <Image Source="ic_crop_4_3.svg"
                                       WidthRequest="26" HeightRequest="26"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       Opacity="{Binding CropVM.SelectedCropMode, Converter={StaticResource SelectedToOpacityConverter}, ConverterParameter=Ratio4_3}"/>
                            </Frame>
                            <Label Text="4:3" FontSize="11" TextColor="White" 
                                   HorizontalTextAlignment="Center" Margin="0"/>
                        </VerticalStackLayout>

                        <!-- 5:4 -->
                        <VerticalStackLayout Spacing="0">
                            <Frame WidthRequest="44" HeightRequest="44"
                                   CornerRadius="12"
                                   Padding="0"
                                   Margin="0"
                                   HasShadow="False"
                                   BorderColor="Transparent"
                                   BackgroundColor="{Binding CropVM.SelectedCropMode, Converter={StaticResource CropModeToColor}, ConverterParameter=Ratio5_4}">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding CropVM.SelectCropModeCommand}" 
                                                          CommandParameter="Ratio5_4"/>
                                </Frame.GestureRecognizers>
                                <Image Source="ic_crop_5_4.svg"
                                       WidthRequest="26" HeightRequest="26"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       Opacity="{Binding CropVM.SelectedCropMode, Converter={StaticResource SelectedToOpacityConverter}, ConverterParameter=Ratio5_4}"/>
                            </Frame>
                            <Label Text="5:4" FontSize="11" TextColor="White" 
                                   HorizontalTextAlignment="Center" Margin="0"/>
                        </VerticalStackLayout>

                        <!-- 7:5 -->
                        <VerticalStackLayout Spacing="0">
                            <Frame WidthRequest="44" HeightRequest="44"
                                   CornerRadius="12"
                                   Padding="0"
                                   Margin="0"
                                   HasShadow="False"
                                   BorderColor="Transparent"
                                   BackgroundColor="{Binding CropVM.SelectedCropMode, Converter={StaticResource CropModeToColor}, ConverterParameter=Ratio7_5}">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding CropVM.SelectCropModeCommand}" 
                                                          CommandParameter="Ratio7_5"/>
                                </Frame.GestureRecognizers>
                                <Image Source="ic_crop_7_5.svg"
                                       WidthRequest="26" HeightRequest="26"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       Opacity="{Binding CropVM.SelectedCropMode, Converter={StaticResource SelectedToOpacityConverter}, ConverterParameter=Ratio7_5}"/>
                            </Frame>
                            <Label Text="7:5" FontSize="11" TextColor="White" 
                                   HorizontalTextAlignment="Center" Margin="0"/>
                        </VerticalStackLayout>

                        <!-- 16:9 -->
                        <VerticalStackLayout Spacing="0">
                            <Frame WidthRequest="44" HeightRequest="44"
                                   CornerRadius="12"
                                   Padding="0"
                                   Margin="0"
                                   HasShadow="False"
                                   BorderColor="Transparent"
                                   BackgroundColor="{Binding CropVM.SelectedCropMode, Converter={StaticResource CropModeToColor}, ConverterParameter=Ratio16_9}">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding CropVM.SelectCropModeCommand}" 
                                                          CommandParameter="Ratio16_9"/>
                                </Frame.GestureRecognizers>
                                <Image Source="ic_crop_16_9.svg"
                                       WidthRequest="26" HeightRequest="26"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       Opacity="{Binding CropVM.SelectedCropMode, Converter={StaticResource SelectedToOpacityConverter}, ConverterParameter=Ratio16_9}"/>
                            </Frame>
                            <Label Text="16:9" FontSize="11" TextColor="White" 
                                   HorizontalTextAlignment="Center" Margin="0"/>
                        </VerticalStackLayout>

                    </HorizontalStackLayout>
                </ScrollView>

                <!-- Divider -->
                <BoxView Grid.Row="1" Color="#333333" HeightRequest="1" HorizontalOptions="Fill"/>

                <!-- Bottom Row (unchanged) -->
                <HorizontalStackLayout Grid.Row="2"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center"
                                        Spacing="20">

                    <Image Source="ic_keyboard_back_edit.svg" WidthRequest="28" HeightRequest="28">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CropVM.CancelCropCommand}"/>
                        </Image.GestureRecognizers>
                    </Image>

                    <BoxView Color="White" Opacity="0.3" WidthRequest="1" HeightRequest="32"/>

                    <Image Source="ic_rotate_edit.svg" WidthRequest="28" HeightRequest="28">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CropVM.Rotate90Command}"/>
                        </Image.GestureRecognizers>
                    </Image>

                    <Image Source="ic_vertical_flip_edit.svg" WidthRequest="28" HeightRequest="28">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CropVM.FlipHorizontalCommand}"/>
                        </Image.GestureRecognizers>
                    </Image>

                    <Image Source="ic_horizontal_flip_edit.svg" WidthRequest="28" HeightRequest="28">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CropVM.FlipVerticalCommand}"/>
                        </Image.GestureRecognizers>
                    </Image>

                </HorizontalStackLayout>
            </Grid>

            <!-- SHAPE EDITING TOOLBAR â€“ Similar to crop toolbar (when shape is selected) -->
            <Grid BackgroundColor="#1E1E1E"
                  IsVisible="{Binding ShapesVM.IsMainToolbarVisible}"
                  HeightRequest="140">
                <Grid.RowDefinitions>
                    <RowDefinition Height="70"/>
                    <RowDefinition Height="1"/>
                    <RowDefinition Height="69"/>
                </Grid.RowDefinitions>

                <!-- Shape Types Row (same as before) -->
                <ScrollView Grid.Row="0" 
                            Orientation="Horizontal"
                            HorizontalScrollBarVisibility="Never"
                            VerticalOptions="Center">
                    <HorizontalStackLayout HorizontalOptions="Start"
                                          VerticalOptions="Center"
                                          Spacing="36"
                                          Padding="20,0">

                        <!-- Rectangle -->
                        <VerticalStackLayout Spacing="6">
                            <Frame WidthRequest="44" HeightRequest="44"
                                   CornerRadius="12"
                                   Padding="0"
                                   Margin="0"
                                   HasShadow="False"
