                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="8,0">
                                    <!-- Outer highlight for selected color (Blue circle) -->
                                    <Border WidthRequest="40" 
                                            HeightRequest="40"
                                            Stroke="#007AFF"
                                            StrokeThickness="3">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="20"/>
                                        </Border.StrokeShape>
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" 
                                                         Binding="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.TextVM.SelectedFillColor}" 
                                                         Value="{Binding .}">
                                                <Setter Property="IsVisible" Value="True"/>
                                            </DataTrigger>
                                        </Border.Triggers>
                                    </Border>
                                    <!-- Color circle -->
                                    <Border BackgroundColor="{Binding .}" 
                                            WidthRequest="36" 
                                            HeightRequest="36"
                                            Stroke="White"
                                            StrokeThickness="1.5"
                                            VerticalOptions="Center"
                                            HorizontalOptions="Center">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="18"/>
                                        </Border.StrokeShape>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer 
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.TextVM.SelectFillColorCommand}"
                                                CommandParameter="{Binding .}"/>
                                        </Border.GestureRecognizers>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </ScrollView>

                <!-- Divider -->
                <BoxView Grid.Row="1" Color="#333333" HeightRequest="1" HorizontalOptions="Fill"/>

                <!-- Bottom Row - Back to Text Editing -->
                <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="12" VerticalOptions="Center" Padding="12,0">
                    
                    <!-- Back Button (Static at start) -->
                    <Image Grid.Column="0" Source="ic_keyboard_back_edit.svg" WidthRequest="28" HeightRequest="28" VerticalOptions="Center">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding TextVM.CloseFillColorPanelCommand}"/>
                        </Image.GestureRecognizers>
                    </Image>

                    <!-- Mild Vertical Line (after back) -->
                    <BoxView Grid.Column="1" Color="White" Opacity="0.3" WidthRequest="1" HeightRequest="32" VerticalOptions="Center"/>

                    <!-- Scrollable Items in the middle -->
                    <ScrollView Grid.Column="2" 
                                Orientation="Horizontal"
                                HorizontalScrollBarVisibility="Never"
                                VerticalOptions="Center">
                        <HorizontalStackLayout Spacing="20" VerticalOptions="Center" Padding="0,0,12,0">
                            
                            <!-- +Add Button -->
                            <Label Text="+Add" 
                                   TextColor="White"
                                   FontSize="14"
                                   VerticalOptions="Center"
                                   HorizontalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnTextAddTapped"/>
                                </Label.GestureRecognizers>
                            </Label>

                            <!-- Font Family Icon -->
                            <Frame WidthRequest="44" HeightRequest="44"
                                   CornerRadius="12"
                                   Padding="0"
                                   HasShadow="False"
                                   BorderColor="Transparent"
                                   BackgroundColor="{Binding TextVM.ShowFontFamilyPanel, Converter={StaticResource BoolToColorConverter}}">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnTextFontFamilyTapped"/>
                                </Frame.GestureRecognizers>
                                <Label Text="Aa" 
                                       FontSize="18" 
                                       FontAttributes="Bold"
                                       TextColor="White"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Frame>

                            <!-- Text Color Icon -->
                            <Frame WidthRequest="44" HeightRequest="44"
                                   CornerRadius="12"
                                   Padding="0"
                                   HasShadow="False"
                                   BorderColor="Transparent"
                                   BackgroundColor="{Binding TextVM.ShowTextColorPanel, Converter={StaticResource BoolToColorConverter}}">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnTextColorTapped"/>
                                </Frame.GestureRecognizers>
                                <VerticalStackLayout Spacing="0" HorizontalOptions="Center" VerticalOptions="Center">
                                    <Label Text="A" 
                                           FontSize="20" 
                                           FontAttributes="Bold"
                                           TextColor="White"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"/>
                                    <BoxView HeightRequest="2" 
                                             WidthRequest="20"
                                             HorizontalOptions="Center"
                                             VerticalOptions="End"
                                             Color="{Binding TextVM.TextColorUnderline}"/>
                                </VerticalStackLayout>
                            </Frame>

                            <!-- Fill Background Color Icon -->
                            <Frame WidthRequest="44" HeightRequest="44"
                                   CornerRadius="12"
                                   Padding="0"
                                   HasShadow="False"
                                   BorderColor="Transparent"
                                   BackgroundColor="{Binding TextVM.ShowFillColorPanel, Converter={StaticResource BoolToColorConverter}}">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnTextFillColorTapped"/>
                                </Frame.GestureRecognizers>
                                <Image Source="ic_fill_color_edit.svg" WidthRequest="28" HeightRequest="28"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Frame>

                            <!-- Bold Icon -->
                            <Frame WidthRequest="44" HeightRequest="44"
                                   CornerRadius="12"
                                   Padding="0"
                                   HasShadow="False"
                                   BorderColor="Transparent"
                                   BackgroundColor="{Binding TextVM.ShowFontAttributesPanel, Converter={StaticResource BoolToColorConverter}}">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnTextFontAttributesTapped"/>
                                </Frame.GestureRecognizers>
                                <Label Text="B" 
                                       FontSize="20" 
                                       FontAttributes="Bold"
                                       TextColor="White"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Frame>
                            
                        </HorizontalStackLayout>
                    </ScrollView>

                    <!-- Mild Vertical Line (before delete) -->
                    <BoxView Grid.Column="3" Color="White" Opacity="0.3" WidthRequest="1" HeightRequest="32" VerticalOptions="Center"/>

                    <!-- Delete Button (Static at end) -->
                    <Image Grid.Column="4" Source="ic_delete_edit.svg" WidthRequest="28" HeightRequest="28" VerticalOptions="Center">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTextDeleteTapped"/>
                        </Image.GestureRecognizers>
                    </Image>

                </Grid>
                </Grid>

                <!-- FONT ATTRIBUTES PANEL -->
                <Grid BackgroundColor="#1E1E1E"
                      IsVisible="{Binding TextVM.ShowFontAttributesPanel}"
                      HeightRequest="140">
                <Grid.Triggers>
                    <DataTrigger TargetType="Grid" 
                                 Binding="{Binding TextVM.IsTextMode}" 
                                 Value="False">
                        <Setter Property="IsVisible" Value="False"/>
                    </DataTrigger>
                    <DataTrigger TargetType="Grid" 
                                 Binding="{Binding TextVM.ShowFontFamilyPanel}" 
                                 Value="True">
                        <Setter Property="IsVisible" Value="False"/>
                    </DataTrigger>
                    <DataTrigger TargetType="Grid" 
                                 Binding="{Binding TextVM.ShowTextColorPanel}" 
                                 Value="True">
                        <Setter Property="IsVisible" Value="False"/>
                    </DataTrigger>
                    <DataTrigger TargetType="Grid" 
                                 Binding="{Binding TextVM.ShowFillColorPanel}" 
                                 Value="True">
                        <Setter Property="IsVisible" Value="False"/>
                    </DataTrigger>
                </Grid.Triggers>
                <Grid.RowDefinitions>
                    <RowDefinition Height="70"/>
                    <RowDefinition Height="1"/>
                    <RowDefinition Height="69"/>
                </Grid.RowDefinitions>

                <!-- Font Attributes Options -->
                <ScrollView Grid.Row="0" 
                            Orientation="Horizontal"
                            HorizontalScrollBarVisibility="Never"
                            VerticalOptions="Center"
                            HorizontalOptions="Center">
                    <HorizontalStackLayout HorizontalOptions="Center"
                                          VerticalOptions="Center"
                                          Spacing="8"
                                          Padding="20,0,20,0">
                        
                        <!-- Bold Option -->
                        <Frame WidthRequest="44"
                               HeightRequest="44"
                               CornerRadius="22"
                               Padding="8"
                               HasShadow="False"
                               BorderColor="Transparent"
                               BackgroundColor="{Binding TextVM.IsBold, Converter={StaticResource BoolToColorConverter}}">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding TextVM.ToggleBoldCommand}"/>
                            </Frame.GestureRecognizers>
                            <Image Source="ic_bold_edit" WidthRequest="28" HeightRequest="28"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Frame>

                        <!-- Italic Option -->
                        <Frame WidthRequest="44"
                               HeightRequest="44"
                               CornerRadius="22"
                               Padding="8"
                               HasShadow="False"
                               BorderColor="Transparent"
                               BackgroundColor="{Binding TextVM.IsItalic, Converter={StaticResource BoolToColorConverter}}">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding TextVM.ToggleItalicCommand}"/>
                            </Frame.GestureRecognizers>
                            <Image Source="ic_italic_edit" WidthRequest="28" HeightRequest="28"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Frame>
                        
                    </HorizontalStackLayout>
                </ScrollView>

                <!-- Divider -->
                <BoxView Grid.Row="1" Color="#333333" HeightRequest="1" HorizontalOptions="Fill"/>

                <!-- Bottom Row - Back to Text Editing -->
                <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="12" VerticalOptions="Center" Padding="12,0">
                    
                    <!-- Back Button (Static at start) -->
                    <Image Grid.Column="0" Source="ic_keyboard_back_edit.svg" WidthRequest="28" HeightRequest="28" VerticalOptions="Center">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding TextVM.CloseFontAttributesPanelCommand}"/>
                        </Image.GestureRecognizers>
                    </Image>

                    <!-- Mild Vertical Line (after back) -->
                    <BoxView Grid.Column="1" Color="White" Opacity="0.3" WidthRequest="1" HeightRequest="32" VerticalOptions="Center"/>

                    <!-- Scrollable Items in the middle -->
                    <ScrollView Grid.Column="2" 
                                Orientation="Horizontal"
                                HorizontalScrollBarVisibility="Never"
                                VerticalOptions="Center">
                        <HorizontalStackLayout Spacing="20" VerticalOptions="Center" Padding="0,0,12,0">
                            
                            <!-- +Add Button -->
                            <Label Text="+Add" 
                                   TextColor="White"
                                   FontSize="14"
                                   VerticalOptions="Center"
                                   HorizontalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnTextAddTapped"/>
                                </Label.GestureRecognizers>
                            </Label>

                            <!-- Font Family Icon -->
                            <Frame WidthRequest="44" HeightRequest="44"
                                   CornerRadius="12"
                                   Padding="0"
                                   HasShadow="False"
                                   BorderColor="Transparent"
                                   BackgroundColor="{Binding TextVM.ShowFontFamilyPanel, Converter={StaticResource BoolToColorConverter}}">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnTextFontFamilyTapped"/>
                                </Frame.GestureRecognizers>
                                <Label Text="Aa" 
                                       FontSize="18" 
                                       FontAttributes="Bold"
                                       TextColor="White"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Frame>

                            <!-- Text Color Icon -->
                            <Frame WidthRequest="44" HeightRequest="44"
                                   CornerRadius="12"
                                   Padding="0"
                                   HasShadow="False"
                                   BorderColor="Transparent"
                                   BackgroundColor="{Binding TextVM.ShowTextColorPanel, Converter={StaticResource BoolToColorConverter}}">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnTextColorTapped"/>
                                </Frame.GestureRecognizers>
                                <VerticalStackLayout Spacing="0" HorizontalOptions="Center" VerticalOptions="Center">
                                    <Label Text="A" 
                                           FontSize="20" 
                                           FontAttributes="Bold"
                                           TextColor="White"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"/>
                                    <BoxView HeightRequest="2" 
                                             WidthRequest="20"
                                             HorizontalOptions="Center"
                                             VerticalOptions="End"
                                             Color="{Binding TextVM.TextColorUnderline}"/>
                                </VerticalStackLayout>
                            </Frame>

                            <!-- Fill Background Color Icon -->
                            <Frame WidthRequest="44" HeightRequest="44"
                                   CornerRadius="12"
                                   Padding="0"
                                   HasShadow="False"
                                   BorderColor="Transparent"
                                   BackgroundColor="{Binding TextVM.ShowFillColorPanel, Converter={StaticResource BoolToColorConverter}}">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnTextFillColorTapped"/>
                                </Frame.GestureRecognizers>
                                <Image Source="ic_fill_color_edit.svg" WidthRequest="28" HeightRequest="28"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Frame>

                            <!-- Bold Icon -->
                            <Frame WidthRequest="44" HeightRequest="44"
                                   CornerRadius="12"
                                   Padding="0"
                                   HasShadow="False"
                                   BorderColor="Transparent"
                                   BackgroundColor="{Binding TextVM.ShowFontAttributesPanel, Converter={StaticResource BoolToColorConverter}}">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnTextFontAttributesTapped"/>
                                </Frame.GestureRecognizers>
                                <Label Text="B" 
                                       FontSize="20" 
                                       FontAttributes="Bold"
                                       TextColor="White"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Frame>
                            
                        </HorizontalStackLayout>
                    </ScrollView>

                    <!-- Mild Vertical Line (before delete) -->
                    <BoxView Grid.Column="3" Color="White" Opacity="0.3" WidthRequest="1" HeightRequest="32" VerticalOptions="Center"/>

                    <!-- Delete Button (Static at end) -->
                    <Image Grid.Column="4" Source="ic_delete_edit.svg" WidthRequest="28" HeightRequest="28" VerticalOptions="Center">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTextDeleteTapped"/>
                        </Image.GestureRecognizers>
                    </Image>

                </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>

