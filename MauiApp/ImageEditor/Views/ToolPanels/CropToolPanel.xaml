<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:MauiApp.ImageEditor.Converters"
             x:Class="MauiApp.ImageEditor.Views.ToolPanels.CropToolPanel"
             BackgroundColor="#2C2C2C">
    <ContentView.Resources>
        <converters:BoolToColorConverter x:Key="BoolToColor" />
    </ContentView.Resources>
    
    <Grid Padding="20" RowDefinitions="Auto,Auto">
        <CollectionView Grid.Row="0"
                        ItemsSource="{Binding AspectRatios}"
                        SelectedItem="{Binding SelectedRatio}"
                        HeightRequest="80">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="15"/>
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame BackgroundColor="{Binding IsSelected, Converter={StaticResource BoolToColor}}"
                           CornerRadius="12" 
                           Padding="15" 
                           HasShadow="False"
                           BorderColor="White">
                        <Label Text="{Binding Name}" 
                               TextColor="White" 
                               FontSize="14"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        
        <Button Grid.Row="1"
                Text="Apply Crop" 
                HorizontalOptions="End" 
                VerticalOptions="End"
                BackgroundColor="#007AFF" 
                TextColor="White"
                CornerRadius="10" 
                Padding="20,12"
                Margin="0,20,0,0"
                Command="{Binding ApplyCropCommand}"/>
    </Grid>
</ContentView>


