<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Views.Maui.Controls;assembly=SkiaSharp.Views.Maui.Controls"
             x:Class="MauiApp.Views.ImageEditPage"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             Padding="0"
             NavigationPage.HasNavigationBar="False"
             NavigationPage.HasBackButton="False">

    <Grid RowDefinitions="Auto,*">
        <!-- Toolbar -->
        <Border BackgroundColor="#512BD4" Padding="10" Grid.Row="0">
            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                <Button Text="Freehand" Clicked="OnFreehand" BackgroundColor="White" TextColor="#512BD4" CornerRadius="8" Padding="12,8"/>
                <Button Text="Rectangle" Clicked="OnRectangle" BackgroundColor="Transparent" TextColor="White" BorderColor="White" BorderWidth="1" CornerRadius="8" Padding="12,8"/>
                <Button Text="Circle" Clicked="OnCircle" BackgroundColor="Transparent" TextColor="White" BorderColor="White" BorderWidth="1" CornerRadius="8" Padding="12,8"/>
                <Button Text="Arrow" Clicked="OnArrow" BackgroundColor="Transparent" TextColor="White" BorderColor="White" BorderWidth="1" CornerRadius="8" Padding="12,8"/>
                <Button Text="Text" Clicked="OnText" BackgroundColor="Transparent" TextColor="White" BorderColor="White" BorderWidth="1" CornerRadius="8" Padding="12,8"/>
                <Button Text="Delete" Clicked="OnDeleteSelected" BackgroundColor="Transparent" TextColor="White" BorderColor="White" BorderWidth="1" CornerRadius="8" Padding="12,8"/>
                <Button Text="Undo" Clicked="OnUndo" BackgroundColor="Transparent" TextColor="White" BorderColor="White" BorderWidth="1" CornerRadius="8" Padding="12,8"/>
                <Button Text="Redo" Clicked="OnRedo" BackgroundColor="Transparent" TextColor="White" BorderColor="White" BorderWidth="1" CornerRadius="8" Padding="12,8"/>
                <Button Text="Save" Clicked="OnSave" BackgroundColor="#673AB7" TextColor="White" CornerRadius="8" Padding="12,8"/>
                <Picker x:Name="colorPicker" Title="Color" SelectedIndex="0" WidthRequest="100">
                    <Picker.ItemsSource>
                        <x:Array Type="{x:Type Color}">
                            <Color>Red</Color>
                            <Color>Blue</Color>
                            <Color>Green</Color>
                            <Color>Yellow</Color>
                            <Color>Black</Color>
                        </x:Array>
                    </Picker.ItemsSource>
                </Picker>
            </HorizontalStackLayout>
        </Border>

        <!-- Canvas with Zoom & Pan -->
        <ScrollView Grid.Row="1" x:Name="scrollView">
            <skia:SKCanvasView x:Name="canvasView"
                               PaintSurface="OnPaintSurface"
                                   EnableTouchEvents="True"
                               Touch="OnTouch">
                <skia:SKCanvasView.GestureRecognizers>
                    <PinchGestureRecognizer PinchUpdated="OnPinch"/>
                </skia:SKCanvasView.GestureRecognizers>
            </skia:SKCanvasView>
        </ScrollView>
    </Grid>
</ContentPage>


