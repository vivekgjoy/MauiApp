<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net9.0-android;net9.0-ios;net9.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net9.0-windows10.0.19041.0</TargetFrameworks>
		<!-- Uncomment to also build the tizen app. You will need to install tizen by following this: https://github.com/Samsung/Tizen.NET -->
		<!-- <TargetFrameworks>$(TargetFrameworks);net9.0-tizen</TargetFrameworks> -->

		<!-- Note for MacCatalyst:
		The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
		When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
		The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
		either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
		<!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

		<OutputType>Exe</OutputType>
		<RootNamespace>MauiApp</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<!-- Disable SourceLink to avoid file lock issues -->
		<PublishRepositoryUrl>false</PublishRepositoryUrl>
		<EmbedUntrackedSources>false</EmbedUntrackedSources>
		<IncludeSymbols>false</IncludeSymbols>

		<!-- Display name -->
		<ApplicationTitle>Smart ERP</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.smart.erp</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
		<WindowsPackageType>None</WindowsPackageType>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		
		<!-- Android specific properties -->
		<EmbedAssembliesIntoApk Condition="'$(TargetFramework)' == 'net9.0-android'">true</EmbedAssembliesIntoApk>
		<AndroidUseSharedRuntime Condition="'$(TargetFramework)' == 'net9.0-android'">false</AndroidUseSharedRuntime>
		<!-- Changed from None to SdkOnly to enable proper .NET linking while preserving app code -->
		<!-- SdkOnly trims unused SDK assemblies but preserves your app code and MAUI's reflection needs -->
		<AndroidLinkMode Condition="'$(TargetFramework)' == 'net9.0-android'">SdkOnly</AndroidLinkMode>
		<AndroidCreatePackagePerAbi Condition="'$(TargetFramework)' == 'net9.0-android'">false</AndroidCreatePackagePerAbi>
		<AndroidLinkTool Condition="'$(TargetFramework)' == 'net9.0-android'">r8</AndroidLinkTool>
		<AndroidEnableAssemblyCompression Condition="'$(TargetFramework)' == 'net9.0-android'">false</AndroidEnableAssemblyCompression>
		<AndroidUseAapt2 Condition="'$(TargetFramework)' == 'net9.0-android'">true</AndroidUseAapt2>
		<AndroidLinkResources Condition="'$(TargetFramework)' == 'net9.0-android'">false</AndroidLinkResources>
		<AndroidDexTool Condition="'$(TargetFramework)' == 'net9.0-android'">d8</AndroidDexTool>
		<!-- ProGuard/R8 rules file - helps preserve MAUI classes even with R8 disabled -->
		<AndroidProguardRules Condition="'$(TargetFramework)' == 'net9.0-android'">Platforms\Android\proguard.cfg</AndroidProguardRules>
		<!-- Fix for missing resource files - limit to common architectures to avoid missing satellite assembly errors -->
		<AndroidSupportedAbis Condition="'$(TargetFramework)' == 'net9.0-android'">arm64-v8a;armeabi-v7a</AndroidSupportedAbis>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'tizen'">6.5</SupportedOSPlatformVersion>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net9.0-android|AnyCPU'">
	  <AndroidPackageFormat>apk</AndroidPackageFormat>
	  <ApplicationId>com.smart.erptest</ApplicationId>
	  <!-- Disable R8 code shrinking to prevent TypeInitializationException in VisualElement -->
	  <!-- R8 aggressively removes code that MAUI needs for reflection-based features -->
	  <AndroidUseR8>false</AndroidUseR8>
	  <!-- Additional safeguards to prevent trimming/shrinking issues -->
	  <PublishTrimmed>false</PublishTrimmed>
	  <AndroidEnableProguard>false</AndroidEnableProguard>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net9.0-android|AnyCPU'">
	  <ApplicationId>com.smart.erptest</ApplicationId>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net9.0-ios|AnyCPU'">
	  <ApplicationId>com.smart.erptest</ApplicationId>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net9.0-maccatalyst|AnyCPU'">
	  <ApplicationId>com.smart.erptest</ApplicationId>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net9.0-windows10.0.19041.0|AnyCPU'">
	  <ApplicationId>com.smart.erptest</ApplicationId>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net9.0-ios|AnyCPU'">
	  <ApplicationId>com.smart.erptest</ApplicationId>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net9.0-maccatalyst|AnyCPU'">
	  <ApplicationId>com.smart.erptest</ApplicationId>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net9.0-windows10.0.19041.0|AnyCPU'">
	  <ApplicationId>com.smart.erptest</ApplicationId>
	</PropertyGroup>

	<ItemGroup>
		<!-- Exclude old ImageEditPage XAML from compilation (replaced by SkiaSharpImageEditorPage) -->
		<MauiXaml Remove="Views\ImageEditPage.xaml" Condition="'$(Configuration)' != ''" />
		
		<!-- ImageEditor XAML files are automatically included by MAUI's default rules -->
		<!-- No need to explicitly include them -->
		
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon_converted.svg" Color="#ED1C24" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\AppIcon\appicon_converted.svg" BaseSize="180,180" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\icon_biometric.svg" Resize="True" BaseSize="32,32" />
		<MauiImage Include="Resources\Images\ic_arrow_back.svg" Resize="True" BaseSize="28,28" />
		<MauiImage Include="Resources\Images\ic_delete.svg" Resize="True" BaseSize="22,22" />
		<MauiImage Include="Resources\Images\ic_pdf_icon.png" />
		<MauiImage Include="Resources\Images\ic_eye_icon.png" />
		
		<!-- Image Editor Icons (in separate folder for easy removal) -->
		<!-- Exclude icons that already exist in Images folder to avoid duplicate filename conflicts -->
		<MauiImage Include="Resources\ImageEditorIcons\*.svg" Resize="True" />
		<MauiImage Remove="Resources\ImageEditorIcons\ic_arrow_back.svg" />
		
		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>


	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="9.0.82" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.0.5" />
		<PackageReference Include="Microsoft.Extensions.Http" Version="9.0.5" />
		<PackageReference Include="System.Text.Json" Version="9.0.5" />
		<PackageReference Include="CommunityToolkit.Maui" Version="9.0.0" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
		<PackageReference Include="Microsoft.Maui.Essentials" Version="9.0.82" />
		<PackageReference Include="SkiaSharp.Views.Maui.Controls" Version="2.88.8" />
		<PackageReference Include="MetadataExtractor" Version="2.9.0" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net9.0-android'">
		<PackageReference Include="Xamarin.AndroidX.Navigation.Runtime" Version="2.8.9.1" />
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="Resources\Drawable\" />
	</ItemGroup>



</Project>
